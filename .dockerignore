# Keep the build context small and secrets out of the image.
.git
.gitignore
.idea
.venv
# ** so these match at any depth, not just the top level.
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Secrets: config comes from compose.yaml / env_file at runtime, never the image.
.env
.env.*
!.env.example

# Not needed at runtime
tests
docs
node_modules
package.json
package-lock.json
rad-shift-admin.postman_collection.json
compose.yaml
Dockerfile
.dockerignore
.github
e2e
infra
test-results
e2e-stack.log
