// Grafana Alloy: reads the rad-shift containers' stdout/stderr from Docker
// and ships it to Loki. (Promtail did this before it was retired.)

// Every container Docker knows about...
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// ...kept only if it belongs to a rad-shift compose project (the dev stack
// or the e2e one), labelled by compose service so a query reads
// {service="backend"}.
discovery.relabel "radshift" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "radshift.*"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "radshift" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.radshift.output
  forward_to = [loki.process.backend_json.receiver]
}

// The backend writes one JSON object per line (app/logs/). Its level becomes
// a label, so {service="backend", level="error"} is an index lookup. The
// request id becomes structured metadata instead: searchable on each line
// ({service="backend"} | request_id="..."), but not a label, because a label
// value per request would make a new stream for every request and swamp
// Loki's index. Other services' lines pass through untouched.
loki.process "backend_json" {
  forward_to = [loki.write.local.receiver]

  stage.match {
    selector = "{service=\"backend\"}"

    stage.json {
      expressions = { level = "", request_id = "" }
    }

    stage.labels {
      values = { level = "" }
    }

    stage.structured_metadata {
      values = { request_id = "" }
    }
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
