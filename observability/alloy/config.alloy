// Grafana Alloy: reads the rad-shift containers' stdout/stderr from Docker
// and ships it to Loki. (Promtail did this before it was retired.)

// Every container Docker knows about...
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// ...kept only if it belongs to a rad-shift compose project (the dev stack
// or the e2e one), labelled by compose service so a query reads
// {service="backend"}.
discovery.relabel "radshift" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "radshift.*"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "radshift" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.radshift.output
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
