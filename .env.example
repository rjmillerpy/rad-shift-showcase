# Every environment variable the backend reads, and nothing else.
# tests/test_env_example.py fails if code and this file drift apart.
# Copy to .env (gitignored, keep it mode 600) and fill in the values.

# --- Configuration (not secret) ---------------------------------------------
DB_USER=
DB_HOST=
DB_PORT=
DB_NAME=
S3_BUCKET_NAME=
# AWS account ID that must own S3_BUCKET_NAME (not secret). S3 rejects the
# request if another account owns it. ECS sets it automatically.
S3_EXPECTED_BUCKET_OWNER=
ALLOWED_ORIGINS=http://localhost:3000
FROM_EMAIL=noreply@radshift.app
APP_URL=http://localhost:3000
# Server-side widget Python/SQL execution is NOT sandboxed. Leave unset/false
# unless the API runs in an isolated container; even when true it is admin-only.
WIDGET_SERVER_EXECUTION_ENABLED=false
# Prometheus scrape endpoint at /metrics (item 15). On unless "false"; ECS
# turns it off because CloudWatch reads the load balancer instead.
METRICS_ENABLED=true
# Feature flags (item 17b): flagd's address. Unset: no flagd, and every flag
# uses its safe fallback (app/flags/constants.py). compose.yaml sets it.
FLAGD_HOST=
# flagd's sync port, for in-process evaluation. Default 8015.
FLAGD_PORT=8015

# Edition (app/plugins.py). `private` makes a missing private package a startup
# error (the production image sets it); `public` forces the public baseline.
# Unset: the private edition when installed, else the public one.
RADSHIFT_EDITION=

# --- Secrets ------------------------------------------------------------------
# At go-live each becomes an SSM SecureString /radshift/<NAME>, loaded with
# scripts/sync_ssm_secrets.py and injected by ECS (infra/). Rotation: README.
# JWT_SECRET must be at least 32 bytes: openssl rand -hex 32
DB_PASSWORD=
JWT_SECRET=
RESEND_API_KEY=
ANTHROPIC_API_KEY=
ADMIN_SECRET=
