# Every environment variable the backend reads, and nothing else.
# tests/test_env_example.py fails if code and this file drift apart.
# Copy to .env (gitignored, keep it mode 600) and fill in the values.

# --- Configuration (not secret) ---------------------------------------------
DB_USER=
DB_HOST=
DB_PORT=
DB_NAME=
S3_BUCKET_NAME=
# AWS account ID that must own S3_BUCKET_NAME (not secret). S3 rejects the
# request if another account owns it. ECS sets it automatically.
S3_EXPECTED_BUCKET_OWNER=
# Media pipeline results queue (item 28; `terraform output results_queue_url`
# in infra/media-pipeline). Set: the API records the WebP variants the Lambda
# makes for each post image. Unset: nothing polls; posts show originals only.
MEDIA_RESULTS_QUEUE_URL=
# Kafka brokers for post events (item 29b, app/engagement/). compose.yaml sets
# kafka:9092. Unset: nothing is published and /posts/trending stays empty.
KAFKA_BOOTSTRAP_SERVERS=
ALLOWED_ORIGINS=http://localhost:3000
FROM_EMAIL=noreply@radshift.app
APP_URL=http://localhost:3000
# Server-side widget Python/SQL execution is NOT sandboxed. Leave unset/false
# unless the API runs in an isolated container; even when true it is admin-only.
WIDGET_SERVER_EXECUTION_ENABLED=false
# Prometheus scrape endpoint at /metrics (item 15). On unless "false"; ECS
# turns it off because CloudWatch reads the load balancer instead.
METRICS_ENABLED=true
# Rate limits on writes and sign-in (app/ratelimit/): on unless "false".
RATE_LIMITS_ENABLED=true
# The generator scheduler runs inside the API unless "false". Kubernetes
# (deploy/helm/) sets false on the scaled API and runs one worker pod instead.
GENERATOR_SCHEDULER_ENABLED=true
# Feature flags (item 17b): flagd's address. Unset: no flagd, and every flag
# uses its safe fallback (app/flags/constants.py). compose.yaml sets it.
FLAGD_HOST=
# flagd's sync port, for in-process evaluation. Default 8015.
FLAGD_PORT=8015

# Edition (app/plugins.py). `private` makes a missing private package a startup
# error (the production image sets it); `public` forces the public baseline.
# Unset: the private edition when installed, else the public one.
RADSHIFT_EDITION=
# Logs (item 24): `json` writes one JSON object per line (what Loki and
# CloudWatch parse); `console` writes readable lines for a terminal.
LOG_RENDERER=json
# DEBUG also shows health checks and Prometheus scrapes.
LOG_LEVEL=INFO
# Error tracking (item 25): the DSN from Sentry's project settings (Client
# Keys). Empty: off. Not a secret (it only lets a client send events), but
# keep yours in .env, not here. The tests always run with it off.
SENTRY_DSN=
# Groups events by where they came from: local, staging, production.
SENTRY_ENVIRONMENT=local
# Share of requests traced for performance (0 to 1). 0: errors only.
SENTRY_TRACES_SAMPLE_RATE=0
# Tracing (item 26, OpenTelemetry): where to send spans over OTLP/HTTP.
# Empty: off. With the observability overlay running, Tempo is at
# http://tempo:4318 (see DOCKER.md); without it, leave this empty.
OTEL_EXPORTER_OTLP_ENDPOINT=
# The service name on every span.
OTEL_SERVICE_NAME=rad-shift-backend

# --- Secrets ------------------------------------------------------------------
# At go-live each becomes an SSM SecureString /radshift/<NAME>, loaded with
# scripts/sync_ssm_secrets.py and injected by ECS (infra/). Rotation: README.
# JWT_SECRET must be at least 32 bytes: openssl rand -hex 32
DB_PASSWORD=
JWT_SECRET=
RESEND_API_KEY=
ANTHROPIC_API_KEY=
ADMIN_SECRET=
