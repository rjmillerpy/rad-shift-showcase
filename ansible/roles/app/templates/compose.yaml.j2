# Managed by Ansible (ansible/roles/app): the API and its database.
name: radshift

services:
  db:
    image: {{ app_postgres_image }}
    restart: unless-stopped
    environment:
      POSTGRES_USER: radshift
      POSTGRES_DB: radshift
      POSTGRES_PASSWORD: ${DB_PASSWORD}
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U radshift -d radshift"]
      interval: 3s
      timeout: 3s
      retries: 20

  backend:
    image: {{ app_backend_image }}
    restart: unless-stopped
    env_file: .env
    ports:
      - "127.0.0.1:{{ app_api_port }}:5000"
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:5000/health')"]
      start_period: 60s
      start_interval: 2s
      interval: 10s
      timeout: 5s
      retries: 3

volumes:
  pgdata:
